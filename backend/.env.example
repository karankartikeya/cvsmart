# Bright Data account API token (Account Settings -> API Tokens).
# This is not the same as a per-zone proxy password.
BRIGHTDATA_API_KEY=

# Scraper Studio collector for job postings, starts with c_
BRIGHTDATA_JOB_COLLECTOR_ID=

# Optional. Leave blank to skip company context entirely.
BRIGHTDATA_COMPANY_COLLECTOR_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Comma separated origins allowed to call the API, for example
# https://coveritt.vercel.app. Localhost and *.vercel.app are already allowed.
ALLOWED_ORIGINS=

# Supabase project (Settings -> API). Auth/DB features stay disabled until set.
SUPABASE_URL=
SUPABASE_JWT_AUD=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Settings -> Database -> Connection string, session pooler).
DATABASE_URL=

# Random long secrets you generate yourself, e.g. `openssl rand -hex 32`.
COOKIE_SIGNING_SECRET=
IP_HASH_SALT=

# Stripe (Developers -> API keys / Webhooks). Test mode keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PREMIUM=
